{
  "title": "MoS2 Contact Physical Transport Regimes and Dataset Classifications",
  "n_samples": 20,
  "regime_definitions": {
    "Regime_I_Quantum_Limited": {
      "name": "Ballistic / Quantum-Limited Regime",
      "rc_range_ohm_um": [
        10.0,
        200.0
      ],
      "rc_range_dex": [
        1.0,
        2.3
      ],
      "criteria": {
        "max_sbh_ev": 0.15,
        "min_n2d_cm2": 10000000000000.0,
        "requires_vdw_or_homojunction": true
      },
      "governing_physics": "Landauer-Sharvin ballistic quantum injection limit. Van der Waals de-pinning or phase-engineered 1T metallic homojunction eliminates the interfacial vacuum barrier, allowing near-unity quantum transmission.",
      "typical_technologies": [
        "Bi(0001) transferred vdW",
        "1T-MoS2 chemical homojunction",
        "Sb(0001)"
      ]
    },
    "Regime_II_Thermionic_Field_Tunneling": {
      "name": "Thermionic-Field / Tunneling-Dominated Regime",
      "rc_range_ohm_um": [
        200.0,
        1500.0
      ],
      "rc_range_dex": [
        2.3,
        3.18
      ],
      "criteria": {
        "max_sbh_ev": 0.45,
        "min_n2d_cm2": 8000000000000.0,
        "requires_vdw_or_homojunction": false
      },
      "governing_physics": "Field emission (Fowler-Nordheim or direct tunneling) through an electrostatically compressed depletion width (W_dep ~ sqrt(eps / n_2D)). Highly responsive to gate bias.",
      "typical_technologies": [
        "Ti/Au evaporated and annealed",
        "Ag",
        "In",
        "Sc"
      ]
    },
    "Regime_III_Thermionic_Emission": {
      "name": "Thermionic Emission-Dominated Regime",
      "rc_range_ohm_um": [
        1500.0,
        15000.0
      ],
      "rc_range_dex": [
        3.18,
        4.18
      ],
      "criteria": {
        "max_sbh_ev": 0.7,
        "min_n2d_cm2": 3000000000000.0,
        "requires_vdw_or_homojunction": false
      },
      "governing_physics": "Classical Richardson-Dushman thermionic emission over the Schottky barrier. Strong exponential temperature dependence J ~ A* T^2 exp(-q*Phi_B / k_B*T).",
      "typical_technologies": [
        "Au evaporated",
        "Ni",
        "Cr",
        "Mo"
      ]
    },
    "Regime_IV_Defect_Dominated_Pinned": {
      "name": "Defect-Dominated / Fermi-Level Pinned Regime",
      "rc_range_ohm_um": [
        15000.0,
        100000.0
      ],
      "rc_range_dex": [
        4.18,
        5.0
      ],
      "criteria": {
        "min_sbh_ev": 0.7,
        "requires_vdw_or_homojunction": false
      },
      "governing_physics": "MIGS (Metal-Induced Gap States) and high-density sulfur vacancy clusters (V_S) pin the Fermi level deep near mid-gap. High work function metals suffer severe thermionic freeze-out and localized defect hopping.",
      "typical_technologies": [
        "Pt transferred/evaporated",
        "Pd unpassivated evaporated"
      ]
    }
  },
